<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.weir</groupId>
  <artifactId>weir</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Weir</name>
  <description>JDBC full/incremental sync without CDC, effectively-once into Paimon/lake/jdbc</description>

  <modules>
    <module>weir-api</module>
    <module>weir-writer-file</module>
    <module>weir-writer-jdbc</module>
    <module>weir-writer-console</module>
    <module>weir-writer-kafka</module>
    <module>weir-writer-doris</module>
    <module>weir-writer-paimon</module>
    <module>weir-dist</module>
    <module>weir-core</module>
    <module>weir-cli</module>
    <module>weir-ds-plugin</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.3</junit.version>
    <h2.version>2.2.224</h2.version>
    <mysql.version>8.4.0</mysql.version>
    <slf4j.version>2.0.13</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-writer-file</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-writer-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-writer-console</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-writer-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-writer-doris</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.weir</groupId>
        <artifactId>weir-writer-paimon</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.dataformat</groupId>
        <artifactId>jackson-dataformat-yaml</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>17</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
